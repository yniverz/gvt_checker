# Copy to .env (or paste these into the Portainer stack "Environment variables" box).
TZ=Europe/Berlin
GVT_LOG_LEVEL=INFO

# Send a test notification on every start to verify the credentials below.
# GVT_TEST_NOTIFIERS is a notifier name from config.yaml, e.g. mail or telegram.
GVT_TEST_ON_STARTUP=false
GVT_TEST_NOTIFIERS=log

# Telegram: create a bot via @BotFather, then get the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot once.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional generic webhook (Discord/Slack/n8n/Home Assistant)
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# Optional SMTP
SMTP_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional: inline YAML config (overrides the /config volume on every start)
GVT_CONFIG_YAML=
